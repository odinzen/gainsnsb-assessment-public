TYPE_DEFINITION % SEQ * !
DEFAULT_COMMAND DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
$
PHASE LIQUID % 1 1.0 !
CONSTITUENT LIQUID : GA,IN,SN,SB : !
PARAMETER G(LIQUID,IN;0) 298.15 +GLIQIN; 6000 N !
PARAMETER G(LIQUID,SN;0) 298.15 +GLIQSN; 6000 N !
PARAMETER G(LIQUID,GA;0) 298.15 +GLIQGA; 6000 N !
PARAMETER G(LIQUID,SB;0) 298.15 +GLIQSB; 6000 N !
PARAMETER G(LIQUID,IN,SN;0) 298.15 -769-0.1312*T; 6000 N !
PARAMETER G(LIQUID,IN,SN;1) 298.15 -119-0.3902*T; 6000 N !
PARAMETER G(LIQUID,GA,IN;0) 298.15 +4345+1.700*T; 6000 N !
PARAMETER G(LIQUID,GA,IN;1) 298.15 -146+0.464*T; 6000 N !
PARAMETER G(LIQUID,GA,IN;2) 298.15 +248; 6000 N !
PARAMETER G(LIQUID,GA,SN;0) 298.15 +3528.5-0.2445*T; 6000 N !
PARAMETER G(LIQUID,GA,SN;1) 298.15 +134.0+1.1714*T; 6000 N !
PARAMETER G(LIQUID,GA,SN;2) 298.15 -261.7-0.7180*T; 6000 N !
PARAMETER G(LIQUID,GA,IN,SN;0) 298.15 -4570.4; 6000 N !
PARAMETER G(LIQUID,GA,IN,SN;1) 298.15 0; 6000 N !
PARAMETER G(LIQUID,GA,IN,SN;2) 298.15 0; 6000 N !
$ Ga-In-Sb ternary liquid: composition-independent a+b*T, fitted (scripts/fit_gainsb_liao.py) to the
$ GaSb-InSb pseudobinary liquidus, the ternary liquidus isotherm points and the 995 K enthalpies of
$ mixing that Liao et al. 1982 assessed. a = 3217 +/- 561 J/mol, b = -24.64 +/- 1.48 J/mol/K.
PARAMETER G(LIQUID,GA,IN,SB;0) 298.15 +3217.1-24.642*T; 6000 N !
PARAMETER G(LIQUID,GA,IN,SB;1) 298.15 +3217.1-24.642*T; 6000 N !
PARAMETER G(LIQUID,GA,IN,SB;2) 298.15 +3217.1-24.642*T; 6000 N !
$ In-Sn-Sb ternary liquid: no term. Vassiliev et al. 2001 found the binary extrapolation reproduces
$ their EMF data without one; checked against their Table 9 with the binaries used here.
$ Ga-Sn-Sb ternary liquid: no term. Binary extrapolation, as in Manasijevic et al. 2010.
$ Sb binary liquids (substitutional RK)
PARAMETER G(LIQUID,GA,SB;0) 298.15 -13953.8+71.07866*T-9.6232*T*LN(T); 6000 N !
PARAMETER G(LIQUID,GA,SB;1) 298.15 +1722.9-1.92588*T; 6000 N !
PARAMETER G(LIQUID,GA,SB;2) 298.15 +2128.3; 6000 N !
PARAMETER G(LIQUID,IN,SB;0) 298.15 -25631.2+102.9324*T-13.45816*T*LN(T); 6000 N !
PARAMETER G(LIQUID,IN,SB;1) 298.15 -2115.4-1.31907*T; 6000 N !
PARAMETER G(LIQUID,IN,SB;2) 298.15 +2908.9; 6000 N !
PARAMETER G(LIQUID,SB,SN;0) 298.15 -5800-2.15*T; 6000 N !
PARAMETER G(LIQUID,SB,SN;1) 298.15 -200-1.45*T; 6000 N !
PARAMETER G(LIQUID,SB,SN;2) 298.15 +2350; 6000 N !
$
$ Gas phase. Ideal mixture of the SGTE substance species listed in the header.
PHASE GAS % 1 1.0 !
CONSTITUENT GAS : GA,GA2,GASB,IN,IN2,SB,SB2,SB3,SB4,SN,SN2 : !
PARAMETER G(GAS,GA;0) 298.15 +F10135T+RTLNP; 6000 N !
PARAMETER G(GAS,GA2;0) 298.15 +F10197T+RTLNP; 6000 N !
PARAMETER G(GAS,GASB;0) 298.15 +GA1SB1G+RTLNP; 6000 N !
PARAMETER G(GAS,SB;0) 298.15 +SB1G+RTLNP; 6000 N !
PARAMETER G(GAS,SB2;0) 298.15 +SB2G+RTLNP; 6000 N !
PARAMETER G(GAS,SB3;0) 298.15 +SB3G+RTLNP; 6000 N !
PARAMETER G(GAS,SB4;0) 298.15 +SB4G+RTLNP; 6000 N !
PARAMETER G(GAS,IN;0) 298.15 +IN1G+RTLNP; 6000 N !
PARAMETER G(GAS,IN2;0) 298.15 +IN2G+RTLNP; 6000 N !
PARAMETER G(GAS,SN;0) 298.15 +F14423T+RTLNP; 6000 N !
PARAMETER G(GAS,SN2;0) 298.15 +F14441T+RTLNP; 6000 N !
$
$ In solid solution (tetragonal). Ga (90Rug) + Sn (David); Sb solubility negligible (not added).
PHASE TETRAGONAL_A6 % 1 1.0 !
CONSTITUENT TETRAGONAL_A6 : GA,IN,SN : !
PARAMETER G(TETRAGONAL_A6,GA;0) 298.15 +GHSERGA+3500-10*T; 6000 N !
PARAMETER G(TETRAGONAL_A6,IN;0) 298.15 +GHSERIN; 6000 N !
PARAMETER G(TETRAGONAL_A6,SN;0) 298.15 +5015.5-7.5*T+GHSERSN; 6000 N !
PARAMETER G(TETRAGONAL_A6,GA,IN;0) 298.15 +9398; 6000 N !
PARAMETER G(TETRAGONAL_A6,GA,SN;0) 298.15 +12000; 6000 N !
PARAMETER G(TETRAGONAL_A6,IN,SN;0) 298.15 +578-1.1232*T; 6000 N !
PARAMETER G(TETRAGONAL_A6,IN,SN;1) 298.15 -1156; 6000 N !
$
$ beta-Sn. Ga (92And) + In (04Dav) + Sb (21Zha).
PHASE BCT_A5 % 1 1.0 !
CONSTITUENT BCT_A5 : GA,IN,SN,SB : !
PARAMETER G(BCT_A5,GA;0) 298.15 +GHSERGA+3846-9.8*T; 6000 N !
PARAMETER G(BCT_A5,SN;0) 298.15 +GHSERSN; 6000 N !
PARAMETER G(BCT_A5,IN;0) 298.15 +2092+GHSERIN; 6000 N !
PARAMETER G(BCT_A5,SB;0) 298.15 +GHSERSB+1000; 6000 N !
PARAMETER G(BCT_A5,GA,SN;0) 298.15 +6700; 6000 N !
PARAMETER G(BCT_A5,GA,IN;0) 298.15 +12000; 6000 N !
PARAMETER G(BCT_A5,IN,SN;0) 298.15 -2554+9.2776*T; 6000 N !
PARAMETER G(BCT_A5,SB,SN;0) 298.15 -5200+12.5*T; 6000 N !
$
$ Sb solid solution (rhombohedral A7). Sn (21Zha). Ga and In solubility in Sb is not reported in
$ the source assessments and is not modelled.
PHASE RHOMBOHEDRAL_A7 % 1 1.0 !
CONSTITUENT RHOMBOHEDRAL_A7 : SB,SN : !
PARAMETER G(RHOMBOHEDRAL_A7,SB;0) 298.15 +GHSERSB; 6000 N !
PARAMETER G(RHOMBOHEDRAL_A7,SN;0) 298.15 +GHSERSN+2035; 6000 N !
PARAMETER G(RHOMBOHEDRAL_A7,SB,SN;0) 298.15 +6400-5*T; 6000 N !
PARAMETER G(RHOMBOHEDRAL_A7,SB,SN;1) 298.15 -5000; 6000 N !
$
$ III-V zincblende (Ga,In)Sb solid solution. Endmembers 94Ans, Ga-In interaction 82Lia.
PHASE ZINCBLENDE_B3 % 2 1.0 1.0 !
CONSTITUENT ZINCBLENDE_B3 : GA,IN : SB : !
PARAMETER G(ZINCBLENDE_B3,GA:SB;0) 298.15 +2*GB3GASB; 6000 N !
PARAMETER G(ZINCBLENDE_B3,IN:SB;0) 298.15 +GHSERIN+GHSERSB-31698.6+0.586278*T+2.587162*T*LN(T); 6000 N !
$ GaSb-InSb solid interaction, Liao et al. 1982 Table V: W_S = 871.7 cal, V_S = -1 cal/K per mole
$ of (Ga,In)Sb, i.e. 3647.2 + 4.184*T J/mol (7326 J/mol at 879 K, the temperature their data fix).
PARAMETER G(ZINCBLENDE_B3,GA,IN:SB;0) 298.15 +3647.2+4.184*T; 6000 N !
$
$ SbSn (beta) and Sb3Sn4, 21Zha. Sb3Sn4 replaces the Sb2Sn3 of earlier assessments
$ (Schmetterer et al. 2017).
PHASE SBSN % 2 3 4 !
CONSTITUENT SBSN : SB : SB,SN,VA : !
PARAMETER G(SBSN,SB:SB;0) 298.15 +7*GHSERSB+88000+42*T; 6000 N !
PARAMETER G(SBSN,SB:VA;0) 298.15 +3*GHSERSB+12100-2*T; 6000 N !
PARAMETER G(SBSN,SB:SN;0) 298.15 +3*GHSERSB+4*GHSERSN-29250+13.7*T; 6000 N !
PARAMETER G(SBSN,SB:SB,SN,VA;0) 298.15 +86000+25.5*T; 6000 N !
PARAMETER G(SBSN,SB:SB,SN,VA;1) 298.15 -48000; 6000 N !
PARAMETER G(SBSN,SB:SB,SN,VA;2) 298.15 0; 6000 N !
$
PHASE SB3SN4 % 2 3 4 !
CONSTITUENT SB3SN4 : SB : SN : !
PARAMETER G(SB3SN4,SB:SN;0) 298.15 +3*GHSERSB+4*GHSERSN-29640+5.2*T; 6000 N !
$
PHASE BETA % 1 1.0 !
CONSTITUENT BETA : IN,SN : !
PARAMETER G(BETA,IN;0) 298.15 +193-0.16479*T+GHSERIN; 6000 N !
PARAMETER G(BETA,SN;0) 298.15 +5015.5-7.5*T+GHSERSN; 6000 N !
PARAMETER G(BETA,IN,SN;0) 298.15 +774-5.4627*T; 6000 N !
PARAMETER G(BETA,IN,SN;1) 298.15 -2379+4.5664*T; 6000 N !
$
PHASE GAMMA % 1 1.0 !
CONSTITUENT GAMMA : IN,SN : !
$ 04Dav pure-In endmember of gamma, unchanged below 600 K. Above 600 K the slope is raised by
$ 15 J/mol/K (continuous in G at 600 K) so gamma can no longer become stable as pure In above 844 K.
PARAMETER G(GAMMA,IN;0) 298.15 +13448-19.676*T+GHSERIN; 600 Y +4448-4.676*T+GHSERIN; 6000 N !
PARAMETER G(GAMMA,SN;0) 298.15 +700-1.3358*T+GHSERSN; 6000 N !
PARAMETER G(GAMMA,IN,SN;0) 298.15 -17314+30.7559*T; 6000 N !
$
PHASE ORTHORHOMBIC_GA % 1 1.0 !
CONSTITUENT ORTHORHOMBIC_GA : GA : !
PARAMETER G(ORTHORHOMBIC_GA,GA;0) 298.15 +GHSERGA; 4000 N !
